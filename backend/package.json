{
  "name": "@trendia/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src api",
    "seed:demo": "tsx scripts/seed-demo-users.ts",
    "seed:catalog": "tsx scripts/seed-demo-catalog.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@trendia/database": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "vitest": "4.1.11"
  }
}
